# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this deployment.
APP_URL="MY_APP_URL"

# Telegram Bot API (Create via @BotFather - never commit real tokens)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_OWNER_ID=""

# Telegram MTProto Personal Account Credentials (my.telegram.org)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_ENCRYPTION_KEY=""

# Bridge between Vercel / PHP Controller and VPS Python Audio Worker
AUDIO_BACKEND_URL="http://127.0.0.1:8080"
AUDIO_BACKEND_API_SECRET=""

# MySQL Database (for cPanel PHP / optional external DB)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="premium_music_bot"
DB_USER=""
DB_PASS=""
