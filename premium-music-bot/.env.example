# Copy to .env and fill with your newly generated credentials
APP_URL=https://your-domain-or-vercel.app

# Telegram Bot API (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace_with_32_char_random_hex
TELEGRAM_OWNER_ID=

# Telegram Personal Account MTProto (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=replace_with_32_byte_base64_key
TELEGRAM_STRING_SESSION_ENC=

# VPS Audio Worker Bridge
AUDIO_BACKEND_URL=https://audio.your-vps-domain.com
AUDIO_BACKEND_API_SECRET=replace_with_64_char_random_hex

# MySQL (cPanel / VPS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=premium_music_bot
DB_USER=
DB_PASS=
